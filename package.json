		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/table-core": "^8.20.5",
		"@upstash/redis": "^1.34.8",
		"arctic": "^3.1.2",
		"better-auth": "^1.7.25",
		"dayjs": "^1.11.19",
		"dotenv": "^16.4.7",
		"drizzle-orm": "^1.0.0-rc.5",
