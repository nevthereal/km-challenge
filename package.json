{
	"name": "km-challenge",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun --bun vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:e2e": "playwright test",
		"test:remote": "node --experimental-strip-types --test tests/*.test.mjs",
		"test": "npm run test:e2e",
		"push": "drizzle-kit push",
		"generate": "drizzle-kit generate",
		"studio": "drizzle-kit studio",
		"start": "PORT=8080 bun ./build"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.5",
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "^1.45.3",
		"@sveltejs/adapter-bun": "^1.0.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/pg": "^8.15.6",
		"bits-ui": "1.5.2",
		"clsx": "^2.1.1",
		"daisyui": "^4.12.23",
		"drizzle-kit": "^1.0.0-rc.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^15.0.0",
		"layerchart": "^2.0.0-next.46",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vite-plugin-devtools-json": "^1.1.2"
	},
	"dependencies": {
		"@better-fetch/fetch": "1.3.3",
