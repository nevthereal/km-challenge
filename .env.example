# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# Optional override for preview deployments or another public origin.
# Localhost ports and https://www.km-challenge.com work without it.
# BETTER_AUTH_URL="https://preview.example.com"
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
GOOGLE_CLIENT_ID="replace-with-your-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-client-secret"
